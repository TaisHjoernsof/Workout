# Public key used in browser PushManager.subscribe
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Private keys used only in Vercel/serverless API routes
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Internal callback auth between QStash and /api/push/send
INTERNAL_API_SECRET=replace_with_random_long_secret

# Upstash Redis (for active timer session guard)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Upstash QStash token (for delayed callbacks)
QSTASH_TOKEN=...

# Optional explicit app URL. If omitted on Vercel, VERCEL_URL is used.
APP_URL=https://your-app.vercel.app
